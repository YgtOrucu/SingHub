@model CreateArtistsDto

@{
    ViewData["Title"] = "Yeni Sanatçı Ekle | SingHub Admin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <div>
        <h1>Yeni Sanatçı Kaydı</h1>
        <p>SingHub platformuna yeni bir vokalis, müzisyen veya müzik grubu ekleyin.</p>
    </div>
    <a href="/Admin/Artists/Index" class="btn-secondary">
        ← Listeye Dön
    </a>
</div>

<div class="form-container">
    <div class="card form-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="color: #ef4444; background-color: #fef2f2; border: 1px solid #fee2e2; padding: 12px; border-radius: 8px; margin-bottom: 20px;"></div>

        <form asp-action="CreateArtists" method="post" autocomplete="off">

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Sanatçı / Grup Adı <span class="required">*</span></label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Örn: The Weeknd, Tarkan, Coldplay" />
                    <span asp-validation-for="Name" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Ülke</label>
                    <input type="text" asp-for="Country" class="form-control" placeholder="Örn: Türkiye, ABD, İngiltere" />
                    <span asp-validation-for="Country" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Doğum / Kuruluş Tarihi</label>
                <input type="date" asp-for="BirthDate" class="form-control" />
                <span asp-validation-for="BirthDate" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Profil Resim URL (Image URL)</label>
                    <input type="text" asp-for="ImageUrl" id="artistImageUrl" class="form-control" placeholder="https://domain.com/artist-profile.jpg" />
                    <span asp-validation-for="ImageUrl" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Banner Görsel URL (Header Banner)</label>
                    <input type="text" asp-for="BannerUrl" id="artistBannerUrl" class="form-control" placeholder="https://domain.com/artist-banner.jpg" />
                    <span asp-validation-for="BannerUrl" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="media-preview-grid">
                <div class="preview-box">
                    <div class="preview-title">Profil Görseli Önizleme</div>
                    <img id="avatarPreview" src="" alt="Avatar Önizleme" style="display:none;" />
                    <span id="avatarPlaceholder">Geçerli Görsel URL'si Giriniz</span>
                </div>

                <div class="preview-box">
                    <div class="preview-title">Banner Görseli Önizleme</div>
                    <img id="bannerPreview" src="" alt="Banner Önizleme" style="display:none;" />
                    <span id="bannerPlaceholder">Geçerli Banner URL'si Giriniz</span>
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label class="form-label">Biyografi</label>
                <textarea asp-for="Biography" class="form-control" rows="5" placeholder="Sanatçının hayatı, müzik kariyeri ve başarıları hakkında bilgi girin..."></textarea>
                <span asp-validation-for="Biography" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-actions">
                <a href="/Admin/Artists/Index" class="btn-cancel">İptal</a>
                <button type="submit" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Sanatçıyı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>