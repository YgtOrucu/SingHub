@model List<ResultArtistsDto>

@{
    ViewData["Title"] = "Sanatçı Yönetimi | SingHub Admin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int itemCount = Model?.Count ?? 0;
}

<div class="page-header">
    <div>
        <h1>Sanatçılar (Artists)</h1>
        <p>SingHub platformundaki sanatçıları, profillerini, albüm ve şarkı metriklerini yönetin.</p>
    </div>
    <a href="/Admin/Artists/CreateArtists" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 4v16m8-8H4" stroke="#fff" stroke-width="2" stroke-linecap="round" />
        </svg>
        Yeni Sanatçı Ekle
    </a>
</div>

<div class="stat-grid">
    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon purple-blue">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
                    <circle cx="12" cy="7" r="4" stroke="#fff" stroke-width="1.8" />
                </svg>
            </div>
            <span class="stat-trend up">Aktif</span>
        </div>
        <div>
            <div class="stat-value">@(Model != null ? ViewBag.TotalCount : 0)</div>
            <div class="stat-label">Toplam Kayıtlı Sanatçı</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.8" />
                </svg>
            </div>
            <span class="stat-trend up">Eserler</span>
        </div>
        <div>
            <div class="stat-value">@(Model != null ? Model.Sum(x => x.SongByArtistCount) : 0)</div>
            <div class="stat-label">Toplam Sanatçı Şarkısı</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
                </svg>
            </div>
            <span class="stat-trend up">Diskografi</span>
        </div>
        <div>
            <div class="stat-value">@(Model != null ? Model.Sum(x => x.SongByAlbumCount) : 0)</div>
            <div class="stat-label">Toplam Albüm Sayısı</div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header">
        <div>
            <h2>Sanatçı Listesi</h2>
            <div class="sub">Platformda yer alan tüm vokaller, gruplar ve müzisyenler</div>
        </div>
        <div class="search-box table-search-box">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
                <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <input type="text" id="artistSearchInput" placeholder="Sanatçı, ülke veya biyografi ara..." />
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Sanatçı</th>
                <th>Ülke</th>
                <th>Doğum Tarihi</th>
                <th>Şarkı / Albüm</th>
                <th class="table-header-right">İşlemler</th>
            </tr>
        </thead>
        <tbody id="artistListBody">
            @if (Model != null && Model.Any())
            {
                @foreach (var artist in Model)
                {
                    <tr>
                        <td>
                            <div class="artist-cell">
                                <div class="artist-avatar">
                                    @if (!string.IsNullOrEmpty(artist.ImageUrl))
                                    {
                                        <img src="@artist.ImageUrl" alt="@artist.Name" onerror="this.src='/images/default-avatar.png'; this.onerror=null;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder">
                                            @(string.IsNullOrEmpty(artist.Name) ? "A" : artist.Name[0].ToString().ToUpper())
                                        </div>
                                    }
                                </div>
                                <div>
                                    <div class="artist-name">@artist.Name</div>
                                    <div class="artist-bio-sub" title="@artist.Biography">
                                        @(string.IsNullOrEmpty(artist.Biography) ? "Biyografi eklenmedi" : (artist.Biography.Length > 45 ? artist.Biography.Substring(0, 45) + "..." : artist.Biography))
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="country-badge">
                                🌐 @(string.IsNullOrEmpty(artist.Country) ? "Belirtilmedi" : artist.Country)
                            </span>
                        </td>
                        <td style="color: var(--text-body);">
                            @(artist.BirthDate != DateTime.MinValue ? artist.BirthDate.ToString("dd.MM.yyyy") : "-")
                        </td>
                        <td>
                            <div class="stats-pill-group">
                                <span class="status-pill active" title="Şarkı Sayısı">🎵 @artist.SongByArtistCount</span>
                                <span class="status-pill pending" title="Albüm Sayısı">💿 @artist.SongByAlbumCount</span>
                            </div>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a href="/Admin/Artists/UpdateArtists/@artist.Id" class="edit-btn" title="Düzenle">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 20h4l10.5-10.5a2.1 2.1 0 000-3L17 5a2.1 2.1 0 00-3 0L4 15v5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                    </svg>
                                </a>
                                <a href="/Admin/Artists/RemoveArtists/@artist.Id" class="delete-btn" title="Sil" onclick="return confirm('@artist.Name sanatçısını silmek istediğinize emin misiniz?');">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M5 7h14M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m-8 0v12a2 2 0 002 2h6a2 2 0 002-2V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="table-empty-cell">
                        Henüz kayıtlı bir sanatçı bulunamadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-wrapper">
        <div class="pagination-info">
            Mevcut Sayfa: <strong>@currentPage</strong> (Bu sayfada <strong>@itemCount</strong> kayıt listeleniyor)
        </div>

        <div class="pagination-controls">
            @if (currentPage > 1)
            {
                <a href="/Admin/Artists/Index?page=@(currentPage - 1)&pageSize=@pageSize" class="page-btn">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Önceki
                </a>
            }
            else
            {
                <button class="page-btn" disabled>
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Önceki
                </button>
            }

            <div class="page-numbers">
                <span class="page-number active">@currentPage</span>
            </div>
            @if (itemCount == pageSize)
            {
                <a href="/Admin/Artists/Index?page=@(currentPage + 1)&pageSize=@pageSize" class="page-btn">
                    Sonraki
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            }
            else
            {
                <button class="page-btn" disabled>
                    Sonraki
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            }
        </div>
    </div>
</div>