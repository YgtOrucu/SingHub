@model UpdateArtistsDto

@{
    ViewData["Title"] = "Sanatçı Düzenle | SingHub Admin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <div>
        <h1>Sanatçı Bilgilerini Düzenle</h1>
        <p><strong>#@Model?.Id</strong> numaralı <strong>@Model?.Name</strong> sanatçısının detaylarını güncelliyorsunuz.</p>
    </div>
    <a href="/Admin/Artists/Index" class="btn-secondary">
        ← Listeye Dön
    </a>
</div>

<div class="form-container">
    <div class="card form-card">
        <form asp-action="UpdateArtists" method="post" autocomplete="off">
            <input type="hidden" asp-for="Id" />

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Sanatçı / Grup Adı <span class="required">*</span></label>
                    <input type="text" asp-for="Name" class="form-control" required />
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Ülke</label>
                    <input type="text" asp-for="Country" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Doğum / Kuruluş Tarihi</label>
                <input type="date" asp-for="BirthDate" class="form-control" value="@(Model?.BirthDate != DateTime.MinValue ? Model?.BirthDate.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Profil Resim URL</label>
                    <input type="text" asp-for="ImageUrl" id="artistImageUrl" class="form-control" />
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Banner Görsel URL</label>
                    <input type="text" asp-for="BannerUrl" id="artistBannerUrl" class="form-control" />
                </div>
            </div>

            <div class="media-preview-grid">
                <div class="preview-box">
                    <div class="preview-title">Profil Görseli Önizleme</div>
                    <img id="avatarPreview" src="@Model?.ImageUrl" alt="Avatar Önizleme" style="@(string.IsNullOrEmpty(Model?.ImageUrl) ? "display:none;" : "display:block;")" />
                    <span id="avatarPlaceholder" style="@(string.IsNullOrEmpty(Model?.ImageUrl) ? "display:block;" : "display:none;")">Geçerli Görsel URL'si Giriniz</span>
                </div>

                <div class="preview-box">
                    <div class="preview-title">Banner Görseli Önizleme</div>
                    <img id="bannerPreview" src="@Model?.BannerUrl" alt="Banner Önizleme" style="@(string.IsNullOrEmpty(Model?.BannerUrl) ? "display:none;" : "display:block;")" />
                    <span id="bannerPlaceholder" style="@(string.IsNullOrEmpty(Model?.BannerUrl) ? "display:block;" : "display:none;")">Geçerli Banner URL'si Giriniz</span>
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label class="form-label">Biyografi</label>
                <textarea asp-for="Biography" class="form-control" rows="5"></textarea>
            </div>

            <div class="form-actions">
                <a href="/Admin/Artists/Index" class="btn-cancel">İptal</a>
                <button type="submit" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <polyline points="17 21 17 13 7 13 7 21" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <polyline points="7 3 7 8 15 8" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>