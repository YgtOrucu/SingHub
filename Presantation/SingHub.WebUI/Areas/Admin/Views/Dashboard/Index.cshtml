@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="page-header">
    <div>
        <h1>Genel Bakış</h1>
        <p>SingHub veritabanınızdaki tüm içerik ve kullanıcı hareketlerini buradan takip edin.</p>
    </div>
</div>
@await Component.InvokeAsync("StatGridCard")
<div class="list-grid">
    @await Component.InvokeAsync("Top5MostListenedToSongs")
    @await Component.InvokeAsync("SpeciesBasedStatisticalDistribution")
</div>

<div class="section-title-row">
    <h3>Sistem &amp; Yetkilendirme Detayları</h3>
    <span>AspNetRoles, SongAppRoles ve AspNetUsers tabloları analizi</span>
</div>

<div class="list-grid">
    @await Component.InvokeAsync("RoleBasedUserDistribution")
    @await Component.InvokeAsync("IdentityVerificationStatus")
</div>
