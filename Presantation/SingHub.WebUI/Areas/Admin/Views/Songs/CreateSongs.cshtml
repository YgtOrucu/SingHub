@model CreateSongsDto

@{
    ViewData["Title"] = "Yeni Şarkı Ekle | SingHub Admin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var artists = ViewBag.Artists as List<SingHub.Dto.ForAdminPageDtos.SongsDto.GetArtistForUpsertDto>;
    var genres = ViewBag.Genres as List<GetGenreForUpsertDto>;
    var albums = ViewBag.Albums as List<GetAlbumForUpsertDto>;
    var roles = ViewBag.Roles as List<GetRolesForUpsertDto>;
}

<div class="page-header">
    <div>
        <h1>Yeni Şarkı Kaydı</h1>
        <p>Sisteme yeni bir şarkı verisi, sanatçı ve tür eşleşmesi ekleyin.</p>
    </div>
    <a href="/Admin/Songs/Index" class="btn-secondary">← Listeye Dön</a>
</div>

<div class="form-container">
    <div class="card form-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="color: #ef4444; background-color: #fef2f2; border: 1px solid #fee2e2; padding: 12px; border-radius: 8px; margin-bottom: 20px;"></div>

        <form asp-action="CreateSongs" method="post" autocomplete="off">

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Şarkı Adı <span class="required">*</span></label>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Blinding Lights, Starboy" />
                    <span asp-validation-for="Title" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Süre (Saniye) <span class="required">*</span></label>
                    <input type="number" asp-for="Duration" class="form-control" placeholder="Örn: 200" />
                    <span asp-validation-for="Duration" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Sanatçı Seçin <span class="required">*</span></label>
                    <select asp-for="ArtistId" class="form-control">
                        <option value="">-- Sanatçı Seçiniz --</option>
                        @if (artists != null)
                        {
                            @foreach (var artist in artists)
                            {
                                <option value="@artist.Id">@artist.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ArtistId" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Müzik Türü Seçin <span class="required">*</span></label>
                    <select asp-for="GenreId" class="form-control">
                        <option value="">-- Tür Seçiniz --</option>
                        @if (genres != null)
                        {
                            @foreach (var genre in genres)
                            {
                                <option value="@genre.Id">@genre.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="GenreId" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Albüm Seçin (Opsiyonel)</label>
                    <select asp-for="AlbumId" class="form-control">
                        <option value="">-- Albüm Seçiniz (Single ise Boş Bırakın) --</option>
                        @if (albums != null)
                        {
                            @foreach (var album in albums)
                            {
                                <option value="@album.Id">@album.Title</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="AlbumId" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label class="form-label">Erişebilecek Paketler / Roller <span class="required">*</span></label>
                <div class="role-checkbox-group" style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; padding: 10px 0;">
                    @if (roles != null && roles.Any())
                    {
                        foreach (var role in roles)
                        {
                            <div class="form-check" style="display: flex; align-items: center; gap: 6px;">
                                <input type="checkbox"
                                       name="SelectedRoleIds"
                                       value="@role.Id"
                                       id="role_@role.Id"
                                       class="form-check-input" />
                                <label class="form-check-label" for="role_@role.Id" style="cursor: pointer; margin: 0;">
                                    @role.Name
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Tanımlı paket/rol bulunamadı.</p>
                    }
                </div>
                <span asp-validation-for="SelectedRoleIds" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Ses Dosyası URL (Audio URL) <span class="required">*</span></label>
                    <input type="text" asp-for="AudioUrl" class="form-control" placeholder="https://domain.com/audio.mp3" />
                    <span asp-validation-for="AudioUrl" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Yayın Tarihi <span class="required">*</span></label>
                    <input type="date" asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Kapak Görsel URL (Cover Image)</label>
                <input type="text" asp-for="CoverImageUrl" id="songCoverUrl" class="form-control" placeholder="https://domain.com/cover.jpg" />
                <span asp-validation-for="CoverImageUrl" style="color: #ef4444; font-size: 13px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="album-preview-wrapper">
                <div class="preview-title">Şarkı Kapak Önizlemesi</div>
                <div class="album-preview-box">
                    <img id="coverPreview" src="" alt="Kapak Önizleme" style="display:none;" />
                    <span id="coverPlaceholder">Geçerli Görsel URL'si Giriniz</span>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Admin/Songs/Index" class="btn-cancel">İptal</a>
                <button type="submit" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Şarkıyı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>