@model UpdateSongsDto

@{
    ViewData["Title"] = "Şarkı Düzenle | SingHub Admin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var artists = ViewBag.Artists as List<SingHub.Dto.ForAdminPageDtos.SongsDto.GetArtistForUpsertDto>;
    var genres = ViewBag.Genres as List<GetGenreForUpsertDto>;
    var albums = ViewBag.Albums as List<GetAlbumForUpsertDto>;
    var roles = ViewBag.Roles as List<GetRolesForUpsertDto>;
}

<div class="page-header">
    <div>
        <h1>Şarkı Bilgilerini Düzenle</h1>
        <p><strong>#@Model?.Id</strong> numaralı <strong>@Model?.Title</strong> şarkı detaylarını güncelliyorsunuz.</p>
    </div>
    <a href="/Admin/Songs/Index" class="btn-secondary">← Listeye Dön</a>
</div>

<div class="form-container">
    <div class="card form-card">
        <form asp-action="UpdateSongs" method="post" autocomplete="off">
            <input type="hidden" asp-for="Id" />

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Şarkı Adı <span class="required">*</span></label>
                    <input type="text" asp-for="Title" class="form-control" required />
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Süre (Saniye) <span class="required">*</span></label>
                    <input type="number" asp-for="Duration" class="form-control" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Sanatçı Seçin <span class="required">*</span></label>
                    <select asp-for="ArtistId" class="form-control" required>
                        <option value="">-- Sanatçı Seçiniz --</option>
                        @if (artists != null)
                        {
                            @foreach (var artist in artists)
                            {
                                <option value="@artist.Id" selected="@(artist.Id == Model?.ArtistId ? "selected" : null)">@artist.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Müzik Türü Seçin <span class="required">*</span></label>
                    <select asp-for="GenreId" class="form-control" required>
                        <option value="">-- Tür Seçiniz --</option>
                        @if (genres != null)
                        {
                            @foreach (var genre in genres)
                            {
                                <option value="@genre.Id" selected="@(genre.Id == Model?.GenreId ? "selected" : null)">@genre.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Albüm Seçin (Opsiyonel)</label>
                    <select asp-for="AlbumId" class="form-control">
                        <option value="">-- Albüm Seçiniz (Single ise Boş Bırakın) --</option>
                        @if (albums != null)
                        {
                            @foreach (var album in albums)
                            {
                                <option value="@album.Id" selected="@(album.Id == Model?.AlbumId ? "selected" : null)">@album.Title</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label class="form-label">Erişebilecek Paketler / Roller <span class="required">*</span></label>
                <div class="role-checkbox-group" style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; padding: 5px 0;">
                    @if (roles != null && roles.Any())
                    {
                        foreach (var role in roles)
                        {
                            bool isChecked = Model?.SelectedRoleIds != null && Model.SelectedRoleIds.Contains(role.Id);

                            <div class="form-check" style="display: flex; align-items: center; gap: 6px;">
                                <input type="checkbox"
                                       name="SelectedRoleIds"
                                       value="@role.Id"
                                       id="role_@role.Id"
                                       class="form-check-input"
                                @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="role_@role.Id" style="cursor: pointer; margin: 0;">
                                    @role.Name
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Tanımlı paket/rol bulunamadı.</p>
                    }
                </div>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">Ses Dosyası URL (Audio URL) <span class="required">*</span></label>
                    <input type="text" asp-for="AudioUrl" class="form-control" required />
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">Yayın Tarihi <span class="required">*</span></label>
                    <input type="date" asp-for="ReleaseDate" class="form-control" value="@(Model?.ReleaseDate != DateTime.MinValue ? Model?.ReleaseDate.ToString("yyyy-MM-dd") : "")" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Kapak Görsel URL (Cover Image)</label>
                <input type="text" asp-for="CoverImageUrl" id="songCoverUrl" class="form-control" />
            </div>

            <div class="album-preview-wrapper">
                <div class="preview-title">Şarkı Kapak Önizlemesi</div>
                <div class="album-preview-box">
                    <img id="coverPreview" src="@Model?.CoverImageUrl" alt="Kapak Önizleme" style="@(string.IsNullOrEmpty(Model?.CoverImageUrl) ? "display:none;" : "display:block;")" />
                    <span id="coverPlaceholder" style="@(string.IsNullOrEmpty(Model?.CoverImageUrl) ? "display:block;" : "display:none;")">Geçerli Görsel URL'si Giriniz</span>
                </div>
            </div>

            <div class="form-actions">
                <a href="/Admin/Songs/Index" class="btn-cancel">İptal</a>
                <button type="submit" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <polyline points="17 21 17 13 7 13 7 21" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>