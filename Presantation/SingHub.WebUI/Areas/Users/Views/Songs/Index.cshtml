@model List<ResultSongsDto>
@{
    ViewData["Title"] = "Şarkılar";
    Layout = "~/Views/PresantationLayout/Index.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="error-alert" role="alert">
        <div class="alert-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 8v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <circle cx="12" cy="16" r="1" fill="currentColor" />
            </svg>
        </div>
        <div class="alert-content">
            <span class="alert-title">Bir hata oluştu</span>
            <p class="alert-message">@TempData["ErrorMessage"]</p>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Şarkılar</h1>
            <p>SingHub kütüphanesindeki tüm şarkıları keşfet ve hemen dinlemeye başla.</p>
        </div>
        <div class="header-meta">
            <span class="count-pill">@(Model?.Count ?? 0) şarkı</span>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.6" /><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.6" /></svg>
            </div>
            <h3>Henüz şarkı bulunmuyor</h3>
            <p>Kütüphaneye yeni şarkılar eklendiğinde burada listelenecek.</p>
        </div>
    }
    else
    {
        <div class="song-grid">
            @foreach (var song in Model)
            {
                var duration = TimeSpan.FromSeconds(song.Duration < 0 ? 0 : song.Duration);
                var durationText = $"{(int)duration.TotalMinutes}:{duration.Seconds:D2}";
                var hasCover = !string.IsNullOrWhiteSpace(song.CoverImageUrl);

                <div class="song-card" data-song-id="@song.Id" data-audio-src="@song.AudioUrl" data-title="@song.Title">
                    <div class="cover-wrap">
                        @if (hasCover)
                        {
                            <img src="@song.CoverImageUrl" alt="@song.Title" class="cover-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="cover-fallback">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5" /><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                            </div>
                        }

                        <div class="cover-overlay"></div>

                        <button type="button" class="play-btn" aria-label="Oynat / Duraklat">
                            <svg class="icon-play" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4.5v15l13-7.5-13-7.5z" fill="#fff" /></svg>
                            <svg class="icon-pause" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;"><rect x="6" y="4.5" width="4" height="15" rx="1" fill="#fff" /><rect x="14" y="4.5" width="4" height="15" rx="1" fill="#fff" /></svg>
                            <span class="icon-spinner" style="display:none;"></span>
                        </button>

                        <div class="eq-bars">
                            <span></span><span></span><span></span><span></span>
                        </div>
                    </div>

                    <div class="song-info">
                        <div class="song-title" title="@song.Title">@song.Title</div>
                        <div class="song-meta">
                            <span class="duration-badge">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                @durationText
                            </span>
                        </div>
                    </div>

                    <audio class="song-audio" preload="none" src="@song.AudioUrl"></audio>
                </div>
            }
        </div>
    }

}

<div class="access-modal-overlay" id="accessToast">
    <div class="access-modal-card">
        <div class="access-modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 8v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <circle cx="12" cy="16" r="1" fill="currentColor" />
            </svg>
        </div>
        <h3 class="access-modal-title" id="accessToastMsg">Erişim Engellendi</h3>
        <p class="access-modal-sub" id="accessToastSub">Bu şarkıyı dinlemek için gerekli rollere sahip değilsiniz.</p>
        <button type="button" class="access-modal-btn" onclick="closeAccessToast()">Tamam</button>
    </div>
</div>