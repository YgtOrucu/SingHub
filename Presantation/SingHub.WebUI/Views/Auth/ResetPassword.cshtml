@model ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password | SingHub";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/resetpassword.css" rel="stylesheet" />
</head>
<body>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>

    <div class="auth-wrapper">
        <div class="brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 18V5l12-2v13" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="6" cy="18" r="3" stroke="#fff" stroke-width="1.8" />
                    <circle cx="18" cy="16" r="3" stroke="#fff" stroke-width="1.8" />
                </svg>
            </div>
            <span class="brand-name">SingHub</span>
        </div>

        <div class="card">
            <h1>Reset your password</h1>
            <p class="subtitle">Enter the 6-digit code we sent to your email, then choose a new password.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-box">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="9" stroke="#fca5a5" stroke-width="1.8" />
                        <path d="M12 8v5" stroke="#fca5a5" stroke-width="1.8" stroke-linecap="round" />
                        <circle cx="12" cy="16" r="0.9" fill="#fca5a5" />
                    </svg>
                    <div>
                        <strong>Couldn't reset your password.</strong>
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <form asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>               
                <input asp-for="Email" value = "@ViewBag.Email" type="hidden" />

                <div class="form-group">
                    <label asp-for="Code">Verification code</label>
                    <input asp-for="Code" class="code-input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="••••••" autocomplete="one-time-code" />
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">New password</label>
                    <input asp-for="NewPassword" class="input-control" type="password" placeholder="••••••••" autocomplete="new-password" />
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm new password</label>
                    <input asp-for="ConfirmPassword" class="input-control" type="password" placeholder="••••••••" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn-primary">Reset Password</button>
            </form>

            <p class="footer-note">
                Remembered it after all? <a asp-controller="Auth" asp-action="Login">Back to Login</a>
            </p>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
