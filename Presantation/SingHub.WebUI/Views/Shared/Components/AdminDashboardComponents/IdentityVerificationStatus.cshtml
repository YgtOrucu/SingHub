@model ResultIdentityVerificationStatus

<div class="card table-card">
    <div class="card-header">
        <div class="title-wrap">
            <span class="mini-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </span>
            <div>
                <h2>Güvenlik &amp; Doğrulama Özeti</h2>
                <div class="sub">AspNetUsers hesap ve yetki durumları</div>
            </div>
        </div>
        <button class="btn-ghost" type="button" data-action="view-all">Kullanıcıları Yönet</button>
    </div>

    <div style="padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 1rem;">

        <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.85rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div class="stat-icon green" style="width: 38px; height: 38px; border-radius: 8px;">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px;"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 0.95rem; color: #fff;">Onaylı Hesaplar</div>
                    <div style="font-size: 0.8rem; opacity: 0.7; margin-top: 2px;">EmailConfirmed = true</div>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: 700; font-size: 1.1rem; color: #fff;">%@Model?.ConfirmedEmailPercentage.ToString("0.0")</div>
                <div style="font-size: 0.75rem; opacity: 0.5;">@Model?.ConfirmedEmailCount.ToString("N0") Kullanıcı</div>
            </div>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.85rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div class="stat-icon cyan" style="width: 38px; height: 38px; border-radius: 8px;">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px;"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 0.95rem; color: #fff;">2FA Korumalı Kullanıcılar</div>
                    <div style="font-size: 0.8rem; opacity: 0.7; margin-top: 2px;">TwoFactorEnabled = true</div>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: 700; font-size: 1.1rem; color: #fff;">@Model?.TwoFactorEnabledCount.ToString("N0")</div>
                <span class="status-pill active" style="font-size: 0.7rem; padding: 2px 6px;">Yüksek Güvenlik</span>
            </div>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div class="stat-icon rose" style="width: 38px; height: 38px; border-radius: 8px;">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 20px; height: 20px;"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 0.95rem; color: #fff;">Geçici Kilitli Hesaplar</div>
                    <div style="font-size: 0.8rem; opacity: 0.7; margin-top: 2px;">LockoutEnd &gt; DateTime.Now</div>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-weight: 700; font-size: 1.1rem; color: #ef4444;">@Model?.LockedOutUserCount.ToString("N0")</div>
                <span class="status-pill banned" style="font-size: 0.7rem; padding: 2px 6px;">Müdahale Gerekebilir</span>
            </div>
        </div>

    </div>
</div>