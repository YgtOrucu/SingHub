@model List<ResultGetRoleBasedUserDistribution>

<div class="card table-card">
    <div class="card-header">
        <div class="title-wrap">
            <span class="mini-icon blue-shield">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
            </span>
            <div>
                <h2>Rol Dağılımları</h2>
                <div class="sub">AspNetRoles veri özeti</div>
            </div>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>ROL ADI</th>
                <th>KULLANICI SAYISI</th>
                <th>ERİŞİM SEVİYESİ</th>
                <th>DURUM</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.RoleName</strong></td>
                        <td>@item.UserCount.ToString("N0")</td>
                        <td>@item.AccessLevel</td>
                        <td>
                            <span class="status-pill @(item.Status == "Aktif" ? "active" : "warning")">
                                <span class="dot"></span> @item.Status
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>