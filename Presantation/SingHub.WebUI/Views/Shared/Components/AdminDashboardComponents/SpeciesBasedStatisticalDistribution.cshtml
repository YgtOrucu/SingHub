<div class="card table-card">
    <div class="card-header">
        <div class="title-wrap">
            <span class="mini-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.6 12.6L12.4 4.4a2 2 0 00-1.4-.6H5a1 1 0 00-1 1v6a2 2 0 00.6 1.4l8.2 8.2a2 2 0 002.8 0l5-5a2 2 0 000-2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="7.5" cy="7.5" r="1.2" stroke="currentColor" stroke-width="1.6" /></svg>
            </span>
            <div>
                <h2>Müzik Türleri Analizi</h2>
                <div class="sub">Genres altındaki içerik yoğunluğu</div>
            </div>
        </div>
        <button class="btn-ghost" type="button" data-action="view-all">Tümünü Gör</button>
    </div>
    <table>
        <thead>
            <tr>
                <th>Tür Adı</th>
                <th>Toplam Şarkı</th>
                <th>Ortalama Süre</th>
                <th>Popülerlik</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="tag-pill">@item.GenreName</span></td>
                    <td>@item.TotalSongCount.ToString("N0")</td>
                    <td>@item.AverageDurationFormatted</td>
                    <td>
                        <span class="status-pill @(item.PopularityLevel == "Yüksek" ? "active" : "pending")">
                            @item.PopularityLevel
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>