@model ResultStatGridCard

<div class="stat-grid">

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon rose">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.6 12.6L12.4 4.4a2 2 0 00-1.4-.6H5a1 1 0 00-1 1v6a2 2 0 00.6 1.4l8.2 8.2a2 2 0 002.8 0l5-5a2 2 0 000-2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="7.5" cy="7.5" r="1.2" stroke="currentColor" stroke-width="1.6" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +14.2%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.4rem; font-weight: 700;">@Model.MostListenedGenre</div>
            <div class="stat-label">En Çok Dinlenen Tür (Genres)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3v10.55" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><circle cx="6.5" cy="17.5" r="3" stroke="currentColor" stroke-width="1.7" /><circle cx="17.5" cy="15.5" r="3" stroke="currentColor" stroke-width="1.7" /><path d="M12 3l7 2v8.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +18.5%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.4rem; font-weight: 700;">@Model.MostPopularArtistName</div>
            <div class="stat-label">Lider Sanatçı (@Model.MostPopularArtistListenCount Dinlenme)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.8" /><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +22.4%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.TotalListenCount">0</div>
            <div class="stat-label">Toplam Dinlenme (ListenCount)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon purple-blue">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.8" /><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +9.1%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.4rem; font-weight: 700;">@Model.MostListenedSongTitle</div>
            <div class="stat-label">Ayın Şarkısı (@Model.MostListenedSongListenCount Dinlenme)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon cyan">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +4.3%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.3rem; font-weight: 700;">%@Model.PremiumUserPercentage Premium</div>
            <div class="stat-label">Rol Dağılımı (AspNetUserRoles)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon amber">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
            </div>
            <span class="stat-trend flat">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                0.0%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.4rem; font-weight: 700;">@Model.AverageSongDurationFormatted</div>
            <div class="stat-label">Ort. Parça Süresi (Duration)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon amber">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +2.1%
            </span>
        </div>
        <div>
            <div class="stat-value" style="font-size: 1.4rem; font-weight: 700;">@Model.AverageSongsPerAlbumFormatted</div>
            <div class="stat-label">Albüm Ortalaması (Albums)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +5.0%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.ActiveCountryCount">0</div>
            <div class="stat-label">Farklı Ülke (Artists.Country)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon violet">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 17l3-9 3 6 2-4 3 6 3-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 20h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
            </div>
            <span class="stat-trend down">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 8l6 6 4-4 6 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                -3.2%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.ArchivedItemCount">0</div>
            <div class="stat-label">Arşivlenen Öğe (IsDeleted)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon cyan">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +8.9%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.TwoFactorEnabledUserCount">0</div>
            <div class="stat-label">2FA Aktif (TwoFactorEnabled)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.8" /><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.8" /></svg>
            </div>
            <span class="stat-trend up">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16l6-6 4 4 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                +31.0%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.MonthlyAddedSongCount">0</div>
            <div class="stat-label">Yeni İçerik (CreatedDate)</div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="stat-top">
            <div class="stat-icon rose">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.6 12.6L12.4 4.4a2 2 0 00-1.4-.6H5a1 1 0 00-1 1v6a2 2 0 00.6 1.4l8.2 8.2a2 2 0 002.8 0l5-5a2 2 0 000-2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="7.5" cy="7.5" r="1.2" stroke="currentColor" stroke-width="1.6" /></svg>
            </div>
            <span class="stat-trend flat">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
                0.0%
            </span>
        </div>
        <div>
            <div class="stat-value" data-count="@Model.LockedOutUserCount">0</div>
            <div class="stat-label">Kilitli Hesap (LockoutEnd)</div>
        </div>
    </div>
</div>