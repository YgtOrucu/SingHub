@model List<ResultTop5MostListenedToSongs>


<div class="card table-card">
    <div class="card-header">
        <div class="title-wrap">
            <span class="mini-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18V5l12-2v13" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6" cy="18" r="3" stroke="#fff" stroke-width="1.8" /><circle cx="18" cy="16" r="3" stroke="#fff" stroke-width="1.8" /></svg>
            </span>
            <div>
                <h2>En Çok Dinlenen Şarkılar</h2>
                <div class="sub">ListenCount parametresine göre sıralı</div>
            </div>
        </div>
        <button class="btn-ghost" type="button" data-action="view-all">Tümünü Gör</button>
    </div>
    <table>
        <thead>
            <tr>
                <th>Şarkı</th>
                <th>Sanatçı</th>
                <th>Tür</th>
                <th>Dinlenme</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="entity-cell">
                            <div class="name">@item.Title</div>
                        </div>
                    </td>
                    <td>@item.ArtistName</td>
                    <td><span class="tag-pill">@item.GenreName</span></td>
                    <td><strong>@(item.ListenCount.ToString("N0") + " k")</strong></td>
                    <td>
                        <div class="row-actions">
                            <button type="button" title="Düzenle" class="edit-btn"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 000-3L17 5a2.1 2.1 0 00-3 0L4 15v5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg></button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>